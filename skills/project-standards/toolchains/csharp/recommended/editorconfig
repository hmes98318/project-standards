root = true

[*]
indent_style = space
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,xml,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# Using directives
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0065.severity = warning

# Formatting
dotnet_diagnostic.IDE0055.severity = warning

# Language style
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_diagnostic.IDE0049.severity = warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = warning
dotnet_style_require_accessibility_modifiers = always:warning
dotnet_diagnostic.IDE0040.severity = warning
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0044.severity = warning

# Naming
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_style.i_prefix_pascal.capitalization = pascal_case
dotnet_naming_style.i_prefix_pascal.required_prefix = I
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix_pascal
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_symbols.nonpublic_fields.applicable_kinds = field
dotnet_naming_symbols.nonpublic_fields.applicable_accessibilities = private,internal
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_rule.nonpublic_fields_underscore_camel.symbols = nonpublic_fields
dotnet_naming_rule.nonpublic_fields_underscore_camel.style = underscore_camel
dotnet_naming_rule.nonpublic_fields_underscore_camel.severity = warning

dotnet_naming_symbols.nonpublic_constants.applicable_kinds = field
dotnet_naming_symbols.nonpublic_constants.applicable_accessibilities = private,internal
dotnet_naming_symbols.nonpublic_constants.required_modifiers = const
dotnet_naming_rule.nonpublic_constants_pascal.symbols = nonpublic_constants
dotnet_naming_rule.nonpublic_constants_pascal.style = pascal
dotnet_naming_rule.nonpublic_constants_pascal.severity = warning

dotnet_naming_symbols.local_constants.applicable_kinds = local
dotnet_naming_symbols.local_constants.applicable_accessibilities = *
dotnet_naming_symbols.local_constants.required_modifiers = const
dotnet_naming_rule.local_constants_pascal.symbols = local_constants
dotnet_naming_rule.local_constants_pascal.style = pascal
dotnet_naming_rule.local_constants_pascal.severity = warning

dotnet_naming_symbols.types_and_members.applicable_kinds = namespace,class,struct,enum,delegate,property,method,event,field
dotnet_naming_symbols.types_and_members.applicable_accessibilities = *
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.types_and_members_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal.style = pascal
dotnet_naming_rule.types_and_members_pascal.severity = warning

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local,parameter
dotnet_naming_symbols.locals_and_parameters.applicable_accessibilities = *
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_rule.locals_and_parameters_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_camel.style = camel
dotnet_naming_rule.locals_and_parameters_camel.severity = warning
